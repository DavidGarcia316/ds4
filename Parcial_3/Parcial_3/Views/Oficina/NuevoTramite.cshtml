@model Parcial_3.Models.Expediente
@{ ViewBag.Title = "Registro"; }

<h3>Registro de Nuevo Trámite</h3>
<hr />

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="panel panel-default">
        <div class="panel-body">

            <div class="row">
                <div class="col-md-4">
                    <div class="form-group">
                        <label>Documento de Identidad</label>
                        @Html.EditorFor(m => m.CedulaIdentidad, new { htmlAttributes = new { @class = "form-control", placeholder = "Ej: 8-888-888" } })
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label>Fecha de Nacimiento</label>
                        @Html.EditorFor(m => m.Nacimiento, new { htmlAttributes = new { @class = "form-control", type = "date" } })
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Nombres</label>
                        @Html.EditorFor(m => m.Nombres, new { htmlAttributes = new { @class = "form-control" } })
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Apellidos</label>
                        @Html.EditorFor(m => m.Apellidos, new { htmlAttributes = new { @class = "form-control" } })
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label>Email de contacto</label>
                @Html.EditorFor(m => m.CorreoElectronico, new { htmlAttributes = new { @class = "form-control" } })
            </div>

            <br />
            <button type="submit" class="btn btn-primary btn-block">Registrar Solicitud</button>
            <br />
            @Html.ActionLink("Cancelar operación", "Inicio", null, new { @class = "text-danger" })
        </div>
    </div>
}