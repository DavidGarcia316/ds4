@{
    ViewBag.Title = "Registrar Venta";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h3>💰 Registrar Venta</h3>
                </div>
                <div class="card-body">
                    <form action="/Libros/Vender" method="post">

                        <div class="form-group mb-3">
                            <label class="form-label">Nombre del Cliente:</label>
                            <input type="text" name="cliente" class="form-control" placeholder="Ej: Juan Pérez" required />
                        </div>

                        <div class="form-group mb-3">
                            <label class="form-label">Seleccionar Libro:</label>
                            @Html.DropDownList("idLibro", (SelectList)ViewBag.Libros, "Seleccione un libro...", new { @class = "form-control", @required = "required" })
                        </div>

                        <div class="form-group mb-3">
                            <label class="form-label">Cantidad a vender:</label>
                            <input type="number" name="cantidad" class="form-control" min="1" value="1" required />
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success btn-lg">Confirmar Venta</button>
                            <a href="@Url.Action("Index", "Libros")" class="btn btn-secondary">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>