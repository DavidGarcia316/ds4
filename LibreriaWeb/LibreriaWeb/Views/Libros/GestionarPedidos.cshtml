@model IEnumerable<LibreriaWeb.Models.Pedido>
@using System.Linq

@{ ViewBag.Title = "Pedidos Pendientes"; }

<div class="container mt-4">
    <h2>📋 Pedidos de Clientes (Carrito Global)</h2>
    <hr />

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success">@TempData["Mensaje"]</div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info mt-3">
            No hay pedidos pendientes por procesar en este momento.
        </div>
    }
    else
    {
        <table class="table table-striped table-hover">
            <thead class="bg-primary text-white">
                <tr>
                    <th>Cliente</th>
                    <th>Libro Solicitado</th>
                    <th>Fecha</th>
                    <th>Acción</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.NombreCliente</td>
                        <td>@item.TituloLibro</td>
                        <td>@item.Fecha.ToString("dd/MM/yyyy")</td>
                        <td>
                            <a href="@Url.Action("Aprobar", "Libros", new { idPedido = item.IdPedido, cliente = item.NombreCliente, idLibro = item.IdLibro, cantidad = 1 })"
                               class="btn btn-success btn-sm">
                                ✅ Aprobar Venta
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <div class="mt-3">
        <a href="@Url.Action("Index", "Libros")" class="btn btn-secondary">Volver al Inventario</a>
    </div>
</div>